#!/bin/sh
# Resumake Pre-Commit Verification Hook
set -e

if command -v fml >/dev/null 2>&1; then
    echo "[PRE-COMMIT 1/4] Checking config synchronization (fml sync --check)..."
    fml sync --check

    echo "[PRE-COMMIT 2/4] Formatting & linting staged files (fml)..."
    fml fmt --staged
    fml lint
else
    echo "[PRE-COMMIT 1/4] (Notice: 'fml' not found in PATH; falling back to cargo fmt / clippy)"
    echo "                 Tip: Install Formality from https://github.com/arvinduh/formality"
    echo "[PRE-COMMIT 1/4] Checking Rust formatting (cargo fmt)..."
    cargo fmt --check

    echo "[PRE-COMMIT 2/4] Running Rust linter (cargo clippy)..."
    cargo clippy --all-targets -- -D warnings
fi

echo "[PRE-COMMIT 3/4] Running test suite (cargo test)..."
cargo test --all-targets

echo "[PRE-COMMIT 4/4] Verifying documentation build (cargo doc)..."
cargo doc --no-deps

echo "[PRE-COMMIT] All local checks PASSED! Creating commit."
