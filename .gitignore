# --- Build & Compiler Outputs ---
/target/
**/*.rs.bk
*.pdb

# --- Resumake & Typst Generated Artifacts ---
.resumake/
*.pdf
output/

# The canonical JSON Schema is never committed — it is generated from
# src/models.rs at release time (`cargo run --example generate-schema`) and
# published only as a GitHub Release asset. Ignore any local copy.
/resume.schema.json
/schema/resume.schema.json

# --- IDEs & Editors ---
.vscode/
.idea/
*.iml
.fleet/
.zed/
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux / Unix
*~
.directory

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Logs & Profiling ---
*.log
*.profraw
*.profdata
crash.dump

# --- Agentic Workflows & Tool Scratches ---
/.artifacts/
# .agents/orchestrate.md and .agents/start.md are the committed process
# files every harness/human references directly - must ship with the
# repo. Only ignore other loose scratch files dropped in .agents/.
/.agents/*
!/.agents/orchestrate.md
!/.agents/start.md
# Directory form (`/.claude/`) would permanently block any future
# `!/.claude/<file>` negation - git never descends into an excluded
# directory. Use the `*` form so a committed convention file (e.g.
# .claude/settings.json) can still be un-ignored later, same shape as
# /.agents/* above.
/.claude/*
