# --- Build & Compiler Outputs ---
/target/
**/*.rs.bk
*.pdb

# --- Resumake & Typst Generated Artifacts ---
.resumake/
*.pdf
output/

# The canonical JSON Schema is derived from src/models.rs at build time
# (`resumake schema --export`) and published as a GitHub Release asset by
# .github/workflows/release.yml. A committed copy here would drift from
# the Rust types the moment either one changes without the other — see
# docs/schema-guide.md#schema-stability--versioning.
/schema/resume.schema.json

# --- IDEs & Editors ---
.vscode/
.idea/
*.iml
.fleet/
.zed/
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux / Unix
*~
.directory

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Logs & Profiling ---
*.log
*.profraw
*.profdata
crash.dump
